{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "honse-rpg-action",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "secrets": {
    "required": [
      "ACTION_API_KEY"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "honse-rpg-action",
      "database_id": "96a84835-2705-4cc7-80e6-0a4210ed97ea",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    }
  }
}
